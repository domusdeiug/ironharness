# Copy to .env and fill in. Never commit .env.

# --- Supabase (Thea project: cyudkegnsibqlgjkvjxs) ---
SUPABASE_URL=https://cyudkegnsibqlgjkvjxs.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=

# --- OpenRouter ---
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_SITE_URL=
OPENROUTER_APP_NAME=thea-harness

# --- Web search (used by ACTION's model-retry diagnostic step, and any
#     profession that lists web_search among its tools). Provider: Brave
#     Search API subscription token. ---
WEB_SEARCH_API_KEY=

# --- web_extract (shared pool) — plain HTTP fetch, no key required.
#     Timeout is tunable per deployment. ---
WEB_EXTRACT_TIMEOUT_SECONDS=15

# --- files profession — sandbox root every files.* tool is confined to.
#     Required if the files profession is active; no default. ---
FILES_SANDBOX_ROOT=

# --- Email profession (SMTP send only; search/delete need an IMAP or
#     provider-API client, not yet implemented) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=

# --- Calendar profession (no provider implemented yet — this just names
#     which one should be, for a clearer "not configured" error) ---
CALENDAR_PROVIDER=

# --- Worker / queue ---
REDIS_URL=redis://localhost:6379/0

# --- App ---
ENVIRONMENT=development
LOG_LEVEL=INFO
